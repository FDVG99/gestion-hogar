#!/bin/sh

echo "========================================"
echo " VALIDACION PREVIA AL PUSH"
echo "========================================"

npm run validate

if [ $? -ne 0 ]; then
  echo ""
  echo "ERROR: Validacion fallida."
  echo "GitHub no recibira los cambios."
  exit 1
fi

echo ""
echo "VALIDACION CORRECTA. PUSH AUTORIZADO."
exit 0